# Copia este archivo como config/.env y completa los datos reales.
# config/.env NO se debe subir al repositorio ni incluir en la entrega.

# Servidor SQL Server
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=OpinionesDW

# Autenticacion SQL
DB_USER=sa
DB_PASSWORD=cambia_esta_clave

# Opciones de conexion (SQL Server remoto o local)
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Si el servidor usa una instancia con nombre en vez de puerto, por ejemplo SQLEXPRESS:
# DB_INSTANCE=SQLEXPRESS
# DB_PORT=

# Rutas y archivos de entrada (relativas a la raiz del proyecto)
DATA_INPUT=./data/input
LOG_DIR=./logs
ARCHIVO_CLIENTES=clientes.csv
ARCHIVO_PRODUCTOS=productos.csv
ARCHIVO_ENCUESTAS=encuestas.csv
ARCHIVO_RESENAS_WEB=resenas_web.csv
ARCHIVO_COMENTARIOS=comentarios_sociales.csv
ARCHIVO_FUENTES=fuentes.csv
ARCHIVO_PALABRAS_CLAVE=palabras_clave.json
ARCHIVO_PRECIOS=precios_categorias.json
